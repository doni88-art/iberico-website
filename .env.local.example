# Supabase project — Settings → API
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Resend — dashboard.resend.com → API Keys
RESEND_API_KEY=
# Optional: a verified sending domain, e.g. "IBÉRICO <reservations@weareiberico.com>"
# Defaults to Resend's shared test address if left unset.
RESEND_FROM=

# Random string of your choosing. Set it as an env var on Vercel AND as a
# GitHub Actions repo secret (Settings → Secrets and variables → Actions) —
# the scheduled workflow in .github/workflows/scheduled-emails.yml sends it
# as a Bearer token so nobody else can trigger the email routes.
CRON_SECRET=
