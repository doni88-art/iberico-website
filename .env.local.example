# Supabase project — Settings → API
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Resend — dashboard.resend.com → API Keys
RESEND_API_KEY=
# Optional: a verified sending domain, e.g. "IBÉRICO <reservations@weareiberico.com>"
# Defaults to Resend's shared test address if left unset.
RESEND_FROM=

# Random string of your choosing — also set as an env var on Vercel.
# Vercel Cron sends it automatically as a Bearer token so nobody else can
# trigger /api/send-confirmations.
CRON_SECRET=
